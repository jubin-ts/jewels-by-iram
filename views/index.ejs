<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero" id="home">
    <div class="hero-slider">
      <div class="hero-slide active" style="background-image: url('/images/hero/hero-1.jpeg')"></div>
      <div class="hero-slide" style="background-image: url('/images/hero/hero-2.jpeg')"></div>
      <div class="hero-slide" style="background-image: url('/images/hero/hero-3.jpeg')"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <img src="/images/logo.jpeg" alt="Jewels by Iram" class="hero-logo">
      <p class="hero-tagline">Where Elegance Meets Craftsmanship</p>
      <div class="hero-divider"><span class="diamond-icon">&#9670;</span></div>
      <p class="hero-subtitle">Luxury Anti-Tarnish Jewelry • Handcrafted with Love</p>
      <div class="hero-buttons">
        <a href="/shop" class="btn btn-gold">Explore Collections</a>
        <a href="https://wa.me/971567241398?text=Hi%2C%20I%27m%20interested%20in%20your%20jewelry%20collection!" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-whatsapp"></i> Chat With Us
        </a>
      </div>
    </div>
    <div class="hero-scroll-indicator">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card reveal-up">
          <i class="fas fa-gem"></i>
          <h3>Anti-Tarnish</h3>
          <p>Premium quality jewelry that maintains its shine and beauty over time</p>
        </div>
        <div class="feature-card reveal-up">
          <i class="fas fa-shipping-fast"></i>
          <h3>UAE Delivery</h3>
          <p>Fast and reliable delivery to all locations across the UAE</p>
        </div>
        <div class="feature-card reveal-up">
          <i class="fas fa-store"></i>
          <h3>Retail & Wholesale</h3>
          <p>Available for individual purchase and bulk wholesale orders</p>
        </div>
        <div class="feature-card reveal-up">
          <i class="fas fa-certificate"></i>
          <h3>Quality Assured</h3>
          <p>Every piece is crafted with attention to detail and quality materials</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Banner -->
  <section class="featured-banner">
    <div class="parallax-bg" style="background-image: url('/images/hero/hero-2.jpeg')"></div>
    <div class="featured-overlay"></div>
    <div class="featured-content">
      <span class="section-label light">Featured</span>
      <h2 class="section-title light">The Signature Collection</h2>
      <p class="featured-text">Discover pieces that define sophistication — designed to be treasured for generations.</p>
      <a href="/shop" class="btn btn-outline-light">View Collection</a>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="section categories-section">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-label">Our Collections</span>
        <h2 class="section-title">Browse by Category</h2>
        <div class="gold-divider centered"></div>
        <p class="section-desc">Explore our diverse range of luxury anti-tarnish jewelry</p>
      </div>
      <div class="categories-grid">
        <% const categoryIcons = { 'bracelets': 'fa-link', 'bangles': 'fa-circle-notch', 'rings': 'fa-ring', 'chains': 'fa-link', 'anklets': 'fa-ankh', 'nose-pins': 'fa-diamond', 'waist-chains': 'fa-infinity' }; %>
        <% categories.forEach(function(cat) { %>
          <a href="/shop?category=<%= cat.slug %>" class="category-card reveal-up">
            <div class="category-icon">
              <i class="fas <%= categoryIcons[cat.slug] || 'fa-gem' %>"></i>
            </div>
            <h3><%= cat.name %></h3>
            <p><%= cat.description %></p>
            <span class="category-link">Explore <i class="fas fa-arrow-right"></i></span>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <% if (featuredProducts.length > 0) { %>
  <section class="section featured-section">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-label">Handpicked for You</span>
        <h2 class="section-title">Featured Collection</h2>
        <div class="gold-divider centered"></div>
        <p class="section-desc">Our most loved pieces, curated for the discerning taste</p>
      </div>
      <div class="products-grid">
        <% featuredProducts.forEach(function(product) { %>
          <div class="product-card reveal-up">
            <a href="/product/<%= product.slug %>" class="product-image">
              <% if (product.primary_image) { %>
                <img src="<%= product.primary_image %>" alt="<%= product.name %>" loading="lazy">
              <% } else { %>
                <div class="product-placeholder"><i class="fas fa-gem"></i></div>
              <% } %>
            </a>
            <div class="product-info">
              <span class="product-category"><%= product.category_name %></span>
              <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
              <div class="product-price">AED <%= product.price.toFixed(2) %></div>
              <button class="btn btn-add-cart" onclick="addToCart(<%= product.id %>)">
                <i class="fas fa-shopping-bag"></i> Add to Cart
              </button>
            </div>
          </div>
        <% }); %>
      </div>
      <div class="text-center mt-4 reveal-up">
        <a href="/shop" class="btn btn-gold">View All Products</a>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Lookbook Section -->
  <section class="lookbook section" id="lookbook">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="section-label">STYLE INSPIRATION</span>
        <h2 class="section-title">The Lookbook</h2>
        <div class="gold-divider centered"></div>
        <p class="section-desc">See our jewelry come alive — styled, worn, and celebrated.</p>
      </div>
      <div class="lookbook-grid">
        <div class="lookbook-item lookbook-large reveal-up">
          <img src="/images/lookbook/model-1.jpeg" alt="Model wearing Jewels by Iram jewelry" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Editorial</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-2.jpeg" alt="Model showcasing necklace" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Bridal</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-3.jpeg" alt="Model with earrings" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Occasion</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-4.jpeg" alt="Styled jewelry look" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Classic</span></div>
        </div>
        <div class="lookbook-item lookbook-large reveal-up">
          <img src="/images/lookbook/model-5.jpeg" alt="Model in designer jewelry" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Couture</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-6.jpeg" alt="Jewelry styling" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Festive</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-7.jpeg" alt="Elegant jewelry look" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Modern</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-8.jpeg" alt="Statement jewelry styling" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Statement</span></div>
        </div>
        <div class="lookbook-item lookbook-large reveal-up">
          <img src="/images/lookbook/model-9.jpeg" alt="Bridal jewelry look" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Bridal</span></div>
        </div>
        <div class="lookbook-item reveal-up">
          <img src="/images/lookbook/model-10.jpeg" alt="Contemporary jewelry styling" loading="lazy">
          <div class="lookbook-overlay"><span class="lookbook-tag">Contemporary</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section reveal-up">
    <div class="container">
      <div class="cta-content">
        <h2>Looking for Wholesale?</h2>
        <p>We offer premium anti-tarnish jewelry at competitive wholesale prices. Contact us for bulk orders and special pricing.</p>
        <div class="cta-buttons">
          <a href="https://wa.me/971567241398?text=Hi%2C%20I%27m%20interested%20in%20wholesale%20pricing!" class="btn btn-gold" target="_blank" rel="noopener noreferrer">
            <i class="fab fa-whatsapp"></i> WhatsApp Us
          </a>
          <a href="tel:+971567241398" class="btn btn-outline">
            <i class="fas fa-phone"></i> Call Now
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram CTA -->
  <section class="section instagram-section reveal-up">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Follow Us</span>
        <h2 class="section-title">@jewels_by_iram.ae</h2>
        <div class="gold-divider centered"></div>
        <p class="section-desc">Follow us on Instagram for the latest collections and updates</p>
      </div>
      <div class="text-center">
        <a href="https://www.instagram.com/jewels_by_iram.ae?igsh=MWdpM2hsNXljbXh6OA==" class="btn btn-instagram" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-instagram"></i> Follow on Instagram
        </a>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
