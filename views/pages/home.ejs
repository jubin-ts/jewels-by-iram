<%- include('../partials/header') %>

<!-- Hero Section -->
<section class="hero" style="background-image: url('/images/products/set-bridal-gold-1.jpeg');">
  <div class="hero-content">
    <h1>Exquisite <span>Handcrafted</span> Jewelry</h1>
    <p>Discover timeless elegance with our curated collection of fine jewelry, handcrafted with love and precision for the modern woman.</p>
    <div class="hero-cta">
      <a href="/shop" class="btn btn-primary btn-lg">Shop Now</a>
      <a href="/about" class="btn btn-outline btn-lg">Our Story</a>
    </div>
  </div>
</section>

<!-- Category Showcase -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Shop by Category</h2>
      <p>Explore our diverse collection of handcrafted jewelry for every occasion</p>
    </div>
    <div class="categories-grid">
      <% categories.forEach(function(cat) { %>
        <a href="/shop?category=<%= cat.slug %>" class="category-card">
          <img src="<%= cat.image || '/images/products/necklace-gold-traditional-1.jpeg' %>" alt="<%= cat.name %>">
          <div class="category-card-overlay">
            <span class="category-card-name"><%= cat.name %></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- Featured Collection -->
<% if (featured && featured.length > 0) { %>
<section class="section" style="background: var(--color-white);">
  <div class="container">
    <div class="section-header">
      <h2>Featured Collection</h2>
      <p>Our most loved pieces, handpicked for you</p>
    </div>
    <div class="product-grid">
      <% featured.forEach(function(product) { %>
        <div class="product-card">
          <div class="product-card-image">
            <a href="/shop/<%= product.slug %>">
              <img src="<%= product.image %>" alt="<%= product.name %>">
            </a>
            <span class="product-badge">Featured</span>
            <% if (user) { %>
              <button class="wishlist-btn" data-product-id="<%= product.id %>" aria-label="Add to wishlist">
                <i class="far fa-heart"></i>
              </button>
            <% } %>
            <div class="product-card-overlay">
              <form class="add-to-cart-form" method="POST" action="/cart/add">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="quick-add-btn"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
              </form>
            </div>
          </div>
          <div class="product-card-body">
            <div class="product-card-category"><%= product.category_name %></div>
            <h3 class="product-card-name"><a href="/shop/<%= product.slug %>"><%= product.name %></a></h3>
            <div class="product-card-price">
              <span class="price-current">₹<%= product.price.toLocaleString('en-IN') %></span>
              <% if (product.original_price) { %>
                <span class="price-original">₹<%= product.original_price.toLocaleString('en-IN') %></span>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

