<%- include('../partials/header') %>

<section class="payment-result">
  <div class="container" style="text-align: center; padding: 80px 20px;">
    <div style="font-size: 64px; margin-bottom: 20px;">✅</div>
    <h1 style="color: #2d8a4e; margin-bottom: 16px;">Payment Successful!</h1>
    <p style="font-size: 18px; color: #555; margin-bottom: 12px;">
      Thank you for your purchase. Your order has been confirmed.
    </p>
    <% if (orderNumber) { %>
      <p style="font-size: 16px; color: #777;">
        Order Number: <strong><%= orderNumber %></strong>
      </p>
      <a href="/payment/invoice/<%= orderNumber %>" style="display: inline-block; margin-top: 20px; padding: 12px 32px; background: #2d8a4e; color: white; text-decoration: none; border-radius: 4px; font-size: 16px;">
        <i class="fas fa-file-pdf"></i> Download Invoice
      </a>
    <% } %>
    <a href="/shop" style="display: inline-block; margin-top: 30px; padding: 12px 32px; background: #b8860b; color: white; text-decoration: none; border-radius: 4px; font-size: 16px;">Continue Shopping</a>
  </div>
</section>

<%- include('../partials/footer') %>
