<%- include('../partials/header') %>

<section class="payment-result">
  <div class="container" style="text-align: center; padding: 80px 20px;">
    <div style="font-size: 64px; margin-bottom: 20px;">⚠️</div>
    <h1 style="color: #e67e22; margin-bottom: 16px;">Payment Cancelled</h1>
    <p style="font-size: 18px; color: #555; margin-bottom: 12px;">
      You cancelled the payment. Your order is still saved and you can pay later.
    </p>
    <% if (orderNumber) { %>
      <p style="font-size: 16px; color: #777;">
        Order Number: <strong><%= orderNumber %></strong>
      </p>
    <% } %>
    <a href="/cart" style="display: inline-block; margin-top: 30px; padding: 12px 32px; background: #b8860b; color: white; text-decoration: none; border-radius: 4px; font-size: 16px;">Return to Cart</a>
  </div>
</section>

<%- include('../partials/footer') %>
