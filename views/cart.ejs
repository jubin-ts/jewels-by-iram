<%- include('partials/header') %>

  <section class="page-header">
    <div class="container">
      <h1>Your Shopping Bag</h1>
    </div>
  </section>

  <section class="section cart-section">
    <div class="container">
      <div id="cartContent">
        <div class="cart-empty" id="cartEmpty" style="display: none;">
          <i class="fas fa-shopping-bag"></i>
          <h3>Your bag is empty</h3>
          <p>Discover our beautiful collection of anti-tarnish jewelry</p>
          <a href="/shop" class="btn btn-primary">Start Shopping</a>
        </div>

        <div class="cart-layout" id="cartLayout">
          <div class="cart-items" id="cartItems">
            <!-- Cart items loaded via JS -->
          </div>
          <div class="cart-summary">
            <h3>Order Summary</h3>
            <div class="summary-row">
              <span>Subtotal</span>
              <span id="cartSubtotal">AED 0.00</span>
            </div>
            <div class="summary-row">
              <span>Delivery</span>
              <span class="text-gold">FREE</span>
            </div>
            <div class="summary-row summary-total">
              <span>Total</span>
              <span id="cartTotal">AED 0.00</span>
            </div>
            <a href="/checkout" class="btn btn-primary btn-block" id="checkoutBtn">
              Proceed to Checkout
            </a>
            <a href="https://wa.me/971567241398?text=Hi%2C%20I%27d%20like%20to%20place%20an%20order!" class="btn btn-whatsapp btn-block" target="_blank" rel="noopener noreferrer">
              <i class="fab fa-whatsapp"></i> Order via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/js/cart.js"></script>

<%- include('partials/footer') %>
