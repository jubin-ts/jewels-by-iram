<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Jewels by Iram - Luxury Anti-Tarnish Jewelry. Premium bracelets, bangles, rings, chains, anklets, nose pins & waist chains. Retail & Wholesale. Delivery all over UAE.">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" type="image/jpeg" href="/images/logo.jpeg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Bar -->
  <div class="top-bar">
    <div class="container">
      <div class="top-bar-content">
        <span><i class="fas fa-shipping-fast"></i> Free Delivery All Over UAE</span>
        <span><i class="fas fa-gem"></i> Anti-Tarnish Jewelry</span>
        <span><i class="fas fa-store"></i> Retail & Wholesale Available</span>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="navbar" id="navbar">
    <div class="container">
      <a href="/" class="logo">
        <img src="/images/logo.jpeg" alt="Jewels by Iram" class="logo-img">
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/shop" class="nav-link">Shop</a></li>
        <li class="dropdown">
          <a href="/shop" class="nav-link">Categories <i class="fas fa-chevron-down"></i></a>
          <ul class="dropdown-menu">
            <li><a href="/shop?category=bracelets">Bracelets</a></li>
            <li><a href="/shop?category=bangles">Bangles</a></li>
            <li><a href="/shop?category=rings">Rings</a></li>
            <li><a href="/shop?category=chains">Chains</a></li>
            <li><a href="/shop?category=anklets">Anklets</a></li>
            <li><a href="/shop?category=nose-pins">Nose Pins</a></li>
            <li><a href="/shop?category=waist-chains">Waist Chains</a></li>
          </ul>
        </li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/contact" class="nav-link">Contact</a></li>
      </ul>
      <div class="nav-actions">
        <a href="/cart" class="cart-icon">
          <i class="fas fa-shopping-bag"></i>
          <span class="cart-badge" id="cartBadge"><%= cartCount %></span>
        </a>
      </div>
    </div>
  </nav>
