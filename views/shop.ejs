<%- include('partials/header') %>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1><%= currentCategory ? currentCategory.name : 'Our Collection' %></h1>
      <p><%= currentCategory ? currentCategory.description : 'Explore our exquisite range of luxury anti-tarnish jewelry' %></p>
    </div>
  </section>

  <!-- Shop Content -->
  <section class="section shop-section">
    <div class="container">
      <div class="shop-layout reveal-up">
        <!-- Sidebar -->
        <aside class="shop-sidebar">
          <div class="sidebar-section">
            <h3>Categories</h3>
            <ul class="category-list">
              <li><a href="/shop" class="<%= !currentCategory ? 'active' : '' %>">All Products</a></li>
              <% categories.forEach(function(cat) { %>
                <li><a href="/shop?category=<%= cat.slug %>" class="<%= currentCategory && currentCategory.id === cat.id ? 'active' : '' %>"><%= cat.name %></a></li>
              <% }); %>
            </ul>
          </div>
        </aside>

        <!-- Products -->
        <div class="shop-content">
          <div class="shop-toolbar">
            <p class="results-count"><%= products.length %> product<%= products.length !== 1 ? 's' : '' %> found</p>
          </div>

          <% if (products.length === 0) { %>
            <div class="empty-state">
              <i class="fas fa-gem"></i>
              <h3>No products found</h3>
              <p>We're adding new pieces to this collection soon. Stay tuned!</p>
              <a href="/shop" class="btn btn-primary">Browse All</a>
            </div>
          <% } else { %>
            <div class="products-grid">
              <% products.forEach(function(product) { %>
                <div class="product-card">
                  <a href="/product/<%= product.slug %>" class="product-image">
                    <% if (product.primary_image) { %>
                      <img src="<%= product.primary_image %>" alt="<%= product.name %>" loading="lazy">
                    <% } else { %>
                      <div class="product-placeholder"><i class="fas fa-gem"></i></div>
                    <% } %>
                  </a>
                  <div class="product-info">
                    <span class="product-category"><%= product.category_name %></span>
                    <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
                    <div class="product-price">AED <%= product.price.toFixed(2) %></div>
                    <button class="btn btn-add-cart" onclick="addToCart(<%= product.id %>)">
                      <i class="fas fa-shopping-bag"></i> Add to Cart
                    </button>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
